rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Mi Cartera: cada usuario solo puede leer y escribir sus propios datos.
    match /users/{uid}/{doc=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Regalos: una lista compartida por dos personas (no toca nada de Mi Cartera).
    match /regalos/{listId} {
      function signedIn() { return request.auth != null; }
      function isMember() { return signedIn() && request.auth.uid in resource.data.members; }
      function inList() {
        return request.auth != null
          && request.auth.uid in get(/databases/$(db)/documents/regalos/$(listId)).data.members;
      }
      function photoOk() {
        return !('photo' in request.resource.data) || request.resource.data.photo.size() < 500000;
      }

      // Crear una lista nueva donde tú eres la única persona.
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];
      // Abrir por link de invitación (el id es aleatorio) y buscar tus propias listas.
      allow get: if signedIn();
      allow list: if isMember();
      // Los miembros solo cambian nombres y fotos de perfil; una segunda persona solo puede agregarse a sí misma.
      allow update: if signedIn() && (
        (isMember() && request.resource.data.members == resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['names', 'avatars'])
          && request.resource.data.get('avatars', {}).size() <= 2)
        || (resource.data.members.size() == 1
          && request.resource.data.members == resource.data.members.concat([request.auth.uid])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names']))
      );
      allow delete: if false;

      // Wishlist: los dos la ven; cada quien agrega, edita y borra solo lo suyo.
      match /items/{itemId} {
        allow read: if inList();
        allow create: if inList() && request.resource.data.owner == request.auth.uid && photoOk();
        allow update: if inList() && resource.data.owner == request.auth.uid
          && request.resource.data.owner == request.auth.uid && photoOk();
        allow delete: if inList() && resource.data.owner == request.auth.uid;
      }

      // Festividades y compras: secretas, solo las ve quien las creó.
      // El presupuesto y la ocasión no se pueden cambiar después de crearla.
      match /privado/{uid}/fiestas/{fiestaId} {
        allow read, delete: if inList() && request.auth.uid == uid;
        allow create: if inList() && request.auth.uid == uid
          && request.resource.data.budget is number && request.resource.data.budget > 0;
        allow update: if inList() && request.auth.uid == uid
          && request.resource.data.budget == resource.data.budget
          && request.resource.data.occasion == resource.data.occasion;
      }

      // Cels donde cada quien activó los avisos de sus festividades (solo los ve y cambia su dueño).
      match /privado/{uid}/avisos/{tokenId} {
        allow read, write: if inList() && request.auth.uid == uid;
      }
    }
  }
}
